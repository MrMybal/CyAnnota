{
  "name": "cyannota",
  "version": "0.3.10",
  "license": "AGPL-3.0-only",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "predev": "node scripts/sync-ffmpeg.mjs",
    "dev": "vinext dev",
    "prebuild": "node scripts/sync-ffmpeg.mjs",
    "build": "vinext build",
    "start": "vinext start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "desktop:renderer:dev": "vite --config desktop/vite.config.ts",
    "desktop:dev": "node desktop/scripts/dev.mjs",
    "desktop:renderer:build": "vite build --config desktop/vite.config.ts",
    "desktop:pack": "npm run desktop:renderer:build && electron-builder --projectDir desktop --config ../electron-builder.yml --dir",
    "desktop:build": "npm run desktop:renderer:build && electron-builder --projectDir desktop --config ../electron-builder.yml --win portable nsis"
  },
  "dependencies": {
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "jszip": "3.10.2",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.8",
    "@cloudflare/workers-types": "5.20260911.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "0.5.34",
    "electron": "44.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.5",
    "react-server-dom-webpack": "19.3.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.9",
    "vite": "8.3.0",
    "wrangler": "4.131.1"
  },
  "type": "module",
  "main": "desktop/main.cjs",
  "description": "CyAnnota - outil autonome d’annotation et de correction d’interfaces",
  "author": "CyberAlien"
}
